# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "QuickRouter"
NEXT_PUBLIC_APP_DESCRIPTION = "QuickRouter is an LLM API gateway: one base URL and one API key for OpenAI, Claude, Gemini, DeepSeek and Grok."
NEXT_PUBLIC_APP_LOGO = "/quickrouter/mark.svg"
NEXT_PUBLIC_APP_FAVICON = "/quickrouter/favicon.svg"
NEXT_PUBLIC_APP_PREVIEW_IMAGE = "/quickrouter/preview.png"

# theme
NEXT_PUBLIC_THEME = "default"
NEXT_PUBLIC_APPEARANCE = "dark"
NEXT_PUBLIC_DEFAULT_LOCALE = "en"
NEXT_PUBLIC_LOCALE_DETECT_ENABLED = "false"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = "postgres://user:password@127.0.0.1:5432/quickrouter"
DB_SCHEMA_FILE = "./src/config/db/schema.postgres.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations"
DB_SCHEMA = "public"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "3"

# auth
AUTH_SECRET = ""
AUTH_URL = "http://localhost:3000"
EMAIL_AUTH_ENABLED = "false"
EMAIL_VERIFICATION_ENABLED = "false"
GOOGLE_AUTH_ENABLED = "false"
GOOGLE_ONE_TAP_ENABLED = "false"
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
GITHUB_AUTH_ENABLED = "false"

# credits
INITIAL_CREDITS_ENABLED = "false"
INITIAL_CREDITS_AMOUNT = "0"
INITIAL_CREDITS_VALID_DAYS = "30"

# payment
SELECT_PAYMENT_ENABLED = "false"
DEFAULT_PAYMENT_PROVIDER = "stripe"
STRIPE_ENABLED = "true"
STRIPE_PUBLISHABLE_KEY = ""
STRIPE_SECRET_KEY = ""
STRIPE_SIGNING_SECRET = ""
STRIPE_PAYMENT_METHODS = '["card"]'
STRIPE_ALLOW_PROMOTION_CODES = "false"
CREEM_ENABLED = "false"
PAYPAL_ENABLED = "false"
PANCAKE_ENABLED = "false"
